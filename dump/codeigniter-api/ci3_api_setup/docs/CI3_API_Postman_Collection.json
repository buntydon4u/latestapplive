        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json.data && json.data.token) {",
                  "  if (json.data.parent_selection_required) {",
                  "    pm.collectionVariables.set('parent_selection_token', json.data.token);",
                  "    if (json.data.parent_id) pm.collectionVariables.set('parent_id', json.data.parent_id);",
                  "  } else {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    if (json.data.user && json.data.user.id) pm.collectionVariables.set('ledger_id', json.data.user.id);",
                  "  }",
                  "}",
                  "pm.test('Response has valid status flag', function () {",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Logs in using tbl_ledger username/password. Saves token automatically."
          },
          "response": []
